# =====================================================================
# Backend Environment Variables - EXAMPLE FILE
# =====================================================================
# Copy this file to .env and fill in your actual credentials
# Never commit .env to version control!

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host:5432/your-database?sslmode=require
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Server Configuration
SERVER_PORT=8080
FILE_BASE_URL=http://localhost:8080

# Spring Profiles
SPRING_PROFILES_ACTIVE=dev

# Security / JWT Configuration
JWT_SECRET=ChangeThisToASecureRandomString32CharsMinimum
JWT_EXPIRATION_MS=86400000
BCRYPT_STRENGTH=12

# Admin User Configuration
# These credentials create the initial admin user on first startup
# IMPORTANT: Change these in production!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@2026
ADMIN_EMAIL=admin@tarkvtark.com
ADMIN_FULL_NAME=System Administrator

# File Upload
FILE_UPLOAD_DIR=./uploads
FILE_MAX_SIZE=10485760

# File storage provider
# Options: local (default), s3, r2, supabase
# - local: files are stored under FILE_UPLOAD_DIR on disk
# - s3 / r2: files are stored in AWS S3 or R2 (configure AWS/R2 vars below)
# - supabase: files are stored in Supabase Storage (configure SUPABASE_* vars)
FILE_PROVIDER=supabase

# ===================== Supabase Storage (recommended) =====================
# Supabase provides both database AND file storage in one place.
# This is the recommended approach for production deployments.
#
# Setup steps:
# 1. Create a Supabase project at https://supabase.com
# 2. Go to Settings → API → Project API Keys
# 3. Copy: Project URL (SUPABASE_URL) and Service Role Key (service_role)
# 4. Create a Storage bucket named "attachments" (Storage → New Bucket)
# 5. Fill in the values below
#
# SECURITY WARNING:
# - SUPABASE_SERVICE_ROLE_KEY is SECRET - Never commit or share it!
# - Keep it in .env only (never in application.yml)
# - Use environment variables in production (GitHub Secrets, CI/CD, etc.)

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_STORAGE_BUCKET=attachments

# IMPORTANT SECURITY NOTES:
# 1. Never commit this file to version control
# 2. Change all default passwords immediately after deployment
# 3. Use strong, unique passwords in production
# 4. Keep this file readable only by the application user

