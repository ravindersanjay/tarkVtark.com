### Backend production environment (.env.prod)
# Provide real secrets via your deployment environment (don't commit this file)

# Spring / Datasource (example for Supabase Postgres)
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://db.<project>.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=<supabase_db_user>
SPRING_DATASOURCE_PASSWORD=<supabase_db_password>
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Server
SERVER_PORT=8080
FILE_BASE_URL=https://api.your-domain.com

# Security
JWT_SECRET=ReplaceWithAStrongRandomStringAtLeast32Chars
JWT_EXPIRATION_MS=86400000

# Admin initial creds (recommended: set via admin UI after provisioning)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeNow!
ADMIN_EMAIL=admin@your-domain.com

# File storage: set to 'supabase' to use Supabase Storage, or 's3'/'r2' as needed
FILE_PROVIDER=supabase

# Supabase Storage settings (required if FILE_PROVIDER=supabase)
SUPABASE_URL=https://<project>.supabase.co
# Use the server-side service_role key here (DO NOT expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=<your_service_role_key>
SUPABASE_STORAGE_BUCKET=attachments

# Optional: AWS / R2 settings (if using those providers instead)
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_S3_BUCKET=
#r2.endpoint=

