### Frontend development env (.env.dev)
# Copy to .env when running the frontend locally (Vite will load .env)

# Backend API
VITE_API_URL=http://localhost:8080/api/v1

# App
VITE_APP_NAME=TarkVtark Debate Arena (dev)
VITE_APP_VERSION=1.0.0-dev

# Supabase (client-side ANON key only - do NOT place service_role here)
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Feature flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_LOGS=true

