### Backend development environment (.env.dev)
# Copy this to .env when running locally (do NOT commit .env to git)

# Spring / Datasource
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/debate_db?sslmode=disable
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Server
SERVER_PORT=8080
FILE_BASE_URL=http://localhost:8080

# Security (use secure values in real environments)
JWT_SECRET=dev-secret-change-me
JWT_EXPIRATION_MS=86400000

# Admin (change for production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@2026
ADMIN_EMAIL=admin@local

# File upload (local)
FILE_PROVIDER=local
FILE_UPLOAD_DIR=./uploads
FILE_MAX_SIZE=10485760

# Supabase (optional - leave blank for local)
#SUPABASE_URL=
#SUPABASE_SERVICE_ROLE_KEY=
#SUPABASE_STORAGE_BUCKET=attachments

