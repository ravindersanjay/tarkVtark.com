# =====================================================================
# Frontend Environment Variables - EXAMPLE FILE
# =====================================================================
# Copy this file to .env and configure for your environment
# This file can be committed to show the structure

# API Base URL - Backend API endpoint
VITE_API_URL=http://localhost:8080/api/v1

# Application Configuration
VITE_APP_NAME=TarkVtark Debate Arena
VITE_APP_VERSION=1.0.0

# ===================== Supabase (optional) =====================
# If your frontend interacts directly with Supabase (e.g., for auth or client-side storage)
# provide the public project URL and the ANON key. Never put service_role keys here.
# The values below are for example only — use your real project URL and anon key in .env.dev/.env.prod
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Feature Flags (optional)
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_LOGS=false

# NOTES:
# - Vite exposes variables as import.meta.env.VITE_*
# - Only VITE_ prefixed variables are exposed to the client
# - Don't put sensitive data here (it's visible in the browser)

