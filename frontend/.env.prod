### Frontend production env (.env.prod)
# Use in your CI/CD or hosting platform (do NOT commit secrets to git)

# Backend API (production URL)
VITE_API_URL=https://api.your-domain.com/api/v1

# App
VITE_APP_NAME=TarkVtark Debate Arena
VITE_APP_VERSION=1.0.0

# Supabase (client ANON key for public operations only)
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=<your_public_anon_key>

# Feature flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG_LOGS=false

